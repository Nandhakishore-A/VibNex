# ---- Server Environment Configuration Template (VIBNEX) ----

# Runtime
NODE_ENV=development
PORT=5000

# Database (MongoDB Atlas Cluster)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/VibNex?retryWrites=true&w=majority

# Auth (JWT_SECRET must be >= 32 chars in production)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars
JWT_EXPIRES_IN=7d

# CORS / Client origins
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Email Delivery Service (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="VIBNEX Platform <no-reply@vibnex.dev>"

# Cloudinary CDN
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=mern_stack_project_storage/VibNex

# Admin Seed
ADMIN_EMAIL=admin@vibnex.dev
ADMIN_USERNAME=vibnexadmin
ADMIN_PASSWORD=your_secure_admin_password
